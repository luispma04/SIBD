        <mxCell id="CDsFOK5z8vJn7LcX807Z-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-1&lt;/b&gt;:&lt;b&gt; &lt;/b&gt;Country that registers boats must have at least one Location.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-2&lt;/b&gt;: Distinct Location points must be at least 1 nautical mile apart.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-3&lt;/b&gt;: Boat Class max_length must be positive.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-4&lt;/b&gt;: Boat length must not exceed its Boat Class max_length.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-5&lt;/b&gt;: Boat length must be positive.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-6&lt;/b&gt;: Reservation end_date must be &amp;gt;= Reservation start_date.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-7&lt;/b&gt;: A given Boat cannot have overlapping Reservations.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-8&lt;/b&gt;: Skipper must be among the authorized sailors for that Reservation.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-9&lt;/b&gt;: Skipper must hold Certification(s) that certify for the Boat class and are valid in navigated jurisdictions at a specific trip time interval.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-10&lt;/b&gt;:&lt;b&gt; &lt;/b&gt;Trip arrival_date must be &amp;gt;= Trip takeoff_date.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-11&lt;/b&gt;: Trip dates must lie within their Reservation start/end dates.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-12&lt;/b&gt;: Trips within the same Reservation must not overlap in time.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-13&lt;/b&gt;: sequence_order must be positive.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;IC-14&lt;/b&gt;: expiry_date must be &amp;gt; issue_date.&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="336" width="450" x="-460" y="803" as="geometry" />
        </mxCell>
